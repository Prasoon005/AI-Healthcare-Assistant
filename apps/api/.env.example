PORT=5000

DATABASE_URL="postgresql://user:password@localhost:5432/ai_healthcare?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Free-tier Google Gemini API key, used for Health Analysis (Phase 10).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# gemini-2.5-flash is used by default for reliability (gemini-3.6-flash is
# newer but was consistently overloaded/rate-limited on the free tier in
# testing). Override here if you want to try a different model.
GEMINI_MODEL="gemini-2.5-flash"
